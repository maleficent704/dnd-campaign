.env
logs/
__pycache__/
*.pyc
.pytest_cache/
.venv/
analysis/*.ipynb_checkpoints/

# Build artifacts
build/
dist/
*.egg-info/

# Campaign state is data, not code, and as of P6.7c none of it is committed.
#
# It used to be: the canon ledger, the chronicle, the NPC book and the sheets were all in
# git, and only `saves/` was ignored. That was against the house rule from the start
# ("never git init a data dir") and it survived because git was the only thing backing
# the campaign up — evicting it before there was somewhere else to put it would have
# traded a rule violation for a real risk of losing the game.
#
# There is somewhere else now (2026-09-06): the `campaigns` volume on the VM, plus a
# nightly age-encrypted backup to the NAS with a rehearsed restore. See docs/DEPLOYMENT.md.
# Git history keeps every version up to that date; what stops is *new* game state landing
# in a code repo.
campaigns/*
!campaigns/.gitkeep

# Normalized SRD output is regenerated by `dndc srd ingest`, never committed (OD-7):
# a normalization bug must not be freezable into the repo. The pinned *raw* data in
# data/srd/raw/ IS committed — that is the version lock.
data/srd/normalized/

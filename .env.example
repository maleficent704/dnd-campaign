# Copy to .env (gitignored). Needed at Phase 1 (P1.1) for the `api` GM adapter.
ANTHROPIC_API_KEY=sk-ant-...

# Where campaign state lives, if not `campaigns/` beside the code. Wins over
# config.yaml's `campaigns.dir` — set it in the deployment, not in the image (P6.7).
# DNDC_CAMPAIGNS_DIR=/data/campaigns

# The LAN gate (P6.7b). A device that reaches the port is at the table — it can take a
# turn, rewrite canon and spend the API budget — so once this is hosted rather than
# started for one evening, it needs a key. Fixed, not per-session: the link is meant to be
# bookmarked. Read docs/LAN-ACCESS.md. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# DNDC_WEB_TOKEN=

# Set by the deployment to say this exposure is bigger than one evening on the LAN, so a
# missing DNDC_WEB_TOKEN refuses to start instead of coming up ungated. A 0.0.0.0 bind
# implies it on its own.
# DNDC_WEB_REQUIRE_TOKEN=1

# --- the hosted table on the VM (P6.7c) -------------------------------------------
# Only the container needs these; they do nothing on Kelly's PC.

# Both of these already have working defaults in deploy/backup.sh and neither is a
# secret, so a normal deployment sets neither. They are here to be found.
#
# The age *public* recipient the nightly NAS backup encrypts to — public on purpose, so
# the timer runs unattended with no passphrase on the VM. Defaults to the one the secrets
# backup already uses; a second key would be a second root of trust to lose.
#   DNDC_BACKUP_RECIPIENT=age1...
#
# Where the encrypted nightly tarball lands.
#   DNDC_BACKUP_DEST=/mnt/truenas/shared/backups/dnd-campaign
